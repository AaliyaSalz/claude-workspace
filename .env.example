# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored, so never commit real keys.

# Supabase: Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Anthropic: console.anthropic.com -> API Keys (server-side only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=your-anthropic-api-key
